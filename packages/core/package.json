{
  "name": "@task-weaver/core",
  "version": "0.3.6",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./types": "./src/types/index.ts",
    "./daemon-release-gate": "./src/services/daemon-release-gate.ts"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node -e \"throw new Error('Publish the verified CE release tarball, not the workspace package')\""
  },
  "dependencies": {
    "@task-weaver/contracts": "workspace:^",
    "@task-weaver/db": "workspace:*",
    "@task-weaver/realtime": "workspace:^",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.3",
    "zod": "^3.24.0",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.8.0"
  },
  "license": "Apache-2.0"
}
