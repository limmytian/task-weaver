{
  "name": "@task-weaver/core",
  "version": "0.3.19",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./types": "./src/types/index.ts",
    "./daemon-release-gate": "./src/services/daemon-release-gate.ts",
    "./mcp-pool": "./src/services/mcp-pool.ts",
    "./mcp-server": "./src/mcp-server/index.ts",
    "./mcp-server/executor": "./src/mcp-server/executor.ts"
  },
  "scripts": {
    "build": "node ../../scripts/workspace-build.mjs package-build",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "typecheck": "node ../../scripts/workspace-build.mjs package-typecheck",
    "prepublishOnly": "node -e \"throw new Error('Publish the verified CE release tarball, not the workspace package')\""
  },
  "dependencies": {
    "@task-weaver/contracts": "workspace:^",
    "@task-weaver/db": "workspace:*",
    "@task-weaver/realtime": "workspace:^",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.3",
    "zod": "4.6.6",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.8.0"
  },
  "license": "Apache-2.0"
}
