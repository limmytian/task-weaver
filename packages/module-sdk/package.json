  },
  "dependencies": {
    "@task-weaver/contracts": "workspace:^",
    "semver": "^7.7.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/semver": "^7.7.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "license": "Apache-2.0"
}
