{
  "name": "@task-weaver/module-sdk",
  "version": "0.2.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./ports": "./src/ports.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
