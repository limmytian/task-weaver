{
  "name": "@task-weaver/partners-gateway",
  "version": "0.3.15",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "build": "node ../../scripts/workspace-build.mjs package-build",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "node ../../scripts/workspace-build.mjs package-typecheck",
    "prepublishOnly": "node -e \"throw new Error('Publish the verified CE release tarball, not the workspace package')\""
  },
  "dependencies": {
    "@task-weaver/contracts": "workspace:^",
    "@task-weaver/core": "workspace:*",
    "@task-weaver/db": "workspace:*",
    "hono": "^4.13.9",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "license": "Apache-2.0"
}
