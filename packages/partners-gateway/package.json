{
  "name": "@task-weaver/partners-gateway",
  "version": "0.3.4",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node -e \"throw new Error('Publish the verified CE release tarball, not the workspace package')\""
  },
  "dependencies": {
    "@task-weaver/contracts": "workspace:^",
    "@task-weaver/core": "workspace:*",
    "@task-weaver/db": "workspace:*",
    "hono": "^4.13.9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "license": "Apache-2.0"
}
