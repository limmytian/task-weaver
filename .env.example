# PostgreSQL must be reachable from the Compose network by all three services.
# Replace every placeholder locally. Never commit a populated .env file.
DATABASE_URL=postgresql://task_weaver:replace-with-a-secret@database.example.invalid:5432/task_weaver

# Optional loopback port overrides.
API_PORT=3001
WEB_PORT=3000

# Override both images together for a verified release. Use OCI digests from
# that release's api-image.digest and web-image.digest assets.
# TW_API_IMAGE=ghcr.io/limmytian/task-weaver-api@sha256:<verified-digest>
# TW_WEB_IMAGE=ghcr.io/limmytian/task-weaver-web@sha256:<verified-digest>
# TW_IMAGE_PLATFORM=linux/arm64

# Set to false on each service to disable manual outbound release checks.
TW_VERSION_CHECK_ENABLED=true

# Required for 0.3.3 source API and Web development; uncomment and replace locally.
# Published digest-pinned Compose images remain unchanged. Inject these variables
# explicitly into both services when using an authenticated image pair.
# TW_AUTH_SECRET=replace-with-a-private-random-secret-at-least-32-characters
# TW_AUTH_BASE_URL=http://localhost:3001
# TW_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# First initialization only; remove from runtime configuration after bootstrap.
# TW_AUTH_BOOTSTRAP_SECRET=replace-with-a-separate-private-random-bootstrap-secret
# Optional finite session/activation settings (seconds).
# TW_AUTH_SESSION_SECONDS=604800
# TW_AUTH_SESSION_IDLE_SECONDS=86400
# TW_AUTH_MAX_SESSION_SECONDS=31536000
# TW_AUTH_ACTIVATION_SECONDS=86400
