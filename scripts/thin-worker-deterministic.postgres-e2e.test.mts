import assert from 'node:assert/strict';
import test from 'node:test';
import { createHash, randomUUID } from 'node:crypto';
import { execFileSync } from 'node:child_process';
import { mkdtemp, mkdir, readFile, rm, writeFile } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';
import { once } from 'node:events';
import { createRequire } from 'node:module';
const apiRequire = createRequire(new URL('../apps/api/package.json', import.meta.url));
const { serve } = await import(apiRequire.resolve('@hono/node-server'));
import { createDb, runMigrations, requirements, tasks, taskDependencies } from '../packages/db/src/index';
import { workflowFromPreset } from '../packages/core/src/index';
const { eq } = await import(apiRequire.resolve('drizzle-orm'));
import { resourcePostgresFixture } from '../apps/api/src/resource-postgres-fixture';
import { provisionThinWorkspace, verifyThinWorkspaceBaselines, type RequirementRepositoryEntry } from '../apps/cli/src/repository-workspace';
import { applyThinDeliveries, captureThinPatches, packageThinArtifacts, publishThinArtifact } from '../apps/cli/src/thin-workspace-artifacts';
import { buildAiEnvironment } from '../apps/cli/src/repository-credentials';
import { runCommand } from '../apps/cli/src/async-command';

const url = process.env.TW_EXECUTION_RECOVERY_E2E_DATABASE_URL;
test('deterministic workers acquire, isolate, publish and unblock acceptance', { skip: !url, timeout: 120000 }, async t => {
  const parsed = new URL(url!); assert.equal(parsed.hostname, '127.0.0.1'); assert.equal(parsed.pathname, '/tw_execution_recovery_e2e');
  await runMigrations(url!);
  const db = createDb(url!); t.after(() => db.$client.end());
  const root = await mkdtemp(join(tmpdir(), 'tw-thin-deterministic-'));
  const oldHome = process.env.HOME, oldStorage = process.env.TW_ATTACHMENT_STORAGE_DIR, oldSystem = process.env.GIT_CONFIG_SYSTEM, oldGlobal = process.env.GIT_CONFIG_GLOBAL;
  process.env.HOME = join(root, 'home'); process.env.TW_ATTACHMENT_STORAGE_DIR = join(root, 'storage');
  process.env.GIT_CONFIG_SYSTEM = '/dev/null'; process.env.GIT_CONFIG_GLOBAL = join(root, 'gitconfig');
  await mkdir(process.env.HOME, { recursive: true });
  await writeFile(process.env.GIT_CONFIG_GLOBAL, '[credential]\n\thelper = store --file /dev/null\n');
  t.after(async () => { for (const [key, value] of [['HOME', oldHome], ['TW_ATTACHMENT_STORAGE_DIR', oldStorage], ['GIT_CONFIG_SYSTEM', oldSystem], ['GIT_CONFIG_GLOBAL', oldGlobal]] as const) { if (value === undefined) delete process.env[key]; else process.env[key] = value; } await rm(root, { recursive: true, force: true }); });
  const git = (args: string[], cwd: string) => execFileSync('git', args, { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim();
  const seed = join(root, 'seed'), remotePath = join(root, 'remote.git'); await mkdir(seed);
  git(['init'], seed); git(['checkout', '-b', 'main'], seed); git(['config', 'user.name', 'Fixture'], seed); git(['config', 'user.email', 'fixture@example.test'], seed);
  await writeFile(join(seed, 'base.txt'), 'base\n'); git(['add', '.'], seed); git(['commit', '-m', 'base'], seed);
  git(['init', '--bare', remotePath], root); git(['remote', 'add', 'origin', remotePath], seed); git(['push', 'origin', 'main'], seed); git(['symbolic-ref', 'HEAD', 'refs/heads/main'], remotePath);
  const f = await resourcePostgresFixture(db, url!);
  const agent = await f.identity.createAgent(f.owner.headers, { displayName: 'Deterministic worker' });
  await f.identity.setMembership(f.owner.headers, f.project.id, agent.id, { role: 'maintainer', explicitPermissions: [] });
  const issue = (actorId: string, manage: boolean) => f.identity.issueKey(f.owner.headers, actorId, { name: 'Worker fixture', expiresAt: null, grants: [{ scope: 'project', projectId: f.project.id, permissions: ['resource.read', 'resource.write', 'execution.run', ...(manage ? ['project.manage' as const] : [])] }] });
  const owner = await issue(f.owner.context.actor.id, true), key = await issue(agent.id, false);
  const server = serve({ fetch: f.app.fetch, hostname: '127.0.0.1', port: 0 }); t.after(() => server.close()); if (!server.listening) await once(server, 'listening');
  const address = server.address(); assert.ok(address && typeof address !== 'string'); const apiUrl = `http://127.0.0.1:${address.port}`;
  const post = async (path: string, body: unknown, credential = key.rawKey) => {
    const response = await fetch(`${apiUrl}${path}`, { method: 'POST', headers: { authorization: `Bearer ${credential}`, 'content-type': 'application/json' }, body: JSON.stringify(body) });
    assert.equal(response.status, 200, await response.clone().text()); return response.json() as Promise<any>;
  };
  await post('/api/v1/thin-workers/mode', { projectId: f.project.id, mode: 'thin', inspection: 'Disposable fixture is empty' }, owner.rawKey);
  const [req] = await db.insert(requirements).values({ projectId: f.project.id, title: 'Parallel delivery', status: 'approved', workflow: workflowFromPreset('attachment'), workflowRevision: 1, workflowStateRevision: 0, createdBy: f.owner.context.actor.id }).returning();
  const children = await db.insert(tasks).values(['Fixture A', 'Fixture B'].map(title => ({ projectId: f.project.id, requirementId: req!.id, title, createdBy: f.owner.context.actor.id }))).returning();
  const [acceptance] = await db.insert(tasks).values({ projectId: f.project.id, requirementId: req!.id, title: 'Accept both', createdBy: f.owner.context.actor.id }).returning();
  await db.insert(taskDependencies).values(children.map(child => ({ taskId: acceptance!.id, dependsOnTaskId: child.id, type: 'blocks' as const })));
  const workerIds = [randomUUID(), randomUUID()];
  const acquire = (workerId: string) => post('/api/v1/thin-workers/acquire', { projectId: f.project.id, workerId, nodeId: `fixture-${workerId}`, executor: 'codex', model: 'gpt-6.1-terra', durationSeconds: 120 });
  const lanes = await Promise.all(workerIds.map(acquire));
  assert.deepEqual(new Set(lanes.map(lane => lane.task.id)), new Set(children.map(child => child.id)));
  assert.equal((await acquire(randomUUID())).task, null);
  const repositoryId = randomUUID();
  const entry: RequirementRepositoryEntry = { link: { id: randomUUID(), requirementId: req!.id, repositoryId, baseBranch: 'main', workingBranch: 'main', deliveryStatus: 'pending', manifestVersion: null, retryCount: 0 }, repository: { id: repositoryId, displayName: 'Fixture', canonicalKey: 'local.test/fixture/repo', provider: 'generic', host: 'local.test', namespace: 'fixture', name: 'repo', defaultBranch: 'main', httpsCloneUrl: pathToFileURL(remotePath).href, sshCloneUrl: null, authPolicy: { allowedTransports: ['https'], preferredTransport: 'https', allowedOperations: ['read'], allowNativeDefault: true } } };
  const results = await Promise.all(lanes.map(async (lane, index) => {
    const fence = { attemptId: lane.attempt.id, workerId: workerIds[index]!, token: lane.token };
    const heartbeat = async () => { await post('/api/v1/thin-workers/heartbeat', { ...fence, durationSeconds: 120 }); };
    const config = { apiUrl, nodeId: `fixture-node-${index}` };
    const workspace = await provisionThinWorkspace({ config, projectId: f.project.id, requirementId: req!.id, taskId: lane.task.id, attemptId: lane.attempt.id, planRevision: lane.attempt.planRevision, entries: [entry], assertAuthority: heartbeat });
    const execution = await runCommand(process.execPath, ['-e', `require('fs').writeFileSync('task-${index}.txt','deterministic ${index}\\n')`], { cwd: workspace.repositories[0]!.worktreePath, env: buildAiEnvironment(process.env), timeoutMs: 10000 });
    assert.equal(execution.ok, true);
    await verifyThinWorkspaceBaselines({ config, workspace, entries: [entry], assertAuthority: heartbeat });
    const patches = await captureThinPatches(workspace, heartbeat);
    const packagePath = await packageThinArtifacts(workspace, patches, heartbeat);
    assert.ok((await readFile(packagePath, 'utf8')).includes(lane.attempt.id));
    const output = await publishThinArtifact({ apiUrl, apiKey: key.rawKey, projectId: f.project.id, ...fence, path: packagePath, assertAuthority: heartbeat });
    const result = await post('/api/v1/thin-workers/result', { ...fence, resultKey: randomUUID(), outcome: 'done', summary: 'Deterministic fixture completed', outputId: output.outputId });
    assert.equal(result.task.status, 'done');
    return { workspace, output };
  }));
  assert.notEqual(results[0]!.workspace.rootPath, results[1]!.workspace.rootPath);
  const acceptWorker = randomUUID();
  const acceptanceLane = await acquire(acceptWorker);
  assert.equal(acceptanceLane.task.id, acceptance!.id);
  const acceptFence = { attemptId: acceptanceLane.attempt.id, workerId: acceptWorker, token: acceptanceLane.token };
  const acceptHeartbeat = async () => { await post('/api/v1/thin-workers/heartbeat', { ...acceptFence, durationSeconds: 120 }); };
  const acceptConfig = { apiUrl, nodeId: 'acceptance-node' };
  const acceptWorkspace = await provisionThinWorkspace({ config: acceptConfig, projectId: f.project.id, requirementId: req!.id, taskId: acceptance!.id, attemptId: acceptanceLane.attempt.id, planRevision: acceptanceLane.attempt.planRevision, entries: [entry], assertAuthority: acceptHeartbeat });
  const packages: string[] = [];
  for (const [index, result] of results.entries()) {
    const response = await fetch(`${apiUrl}/api/v1/documents/${result.output.documentId}/file`, { headers: { authorization: `Bearer ${key.rawKey}` } });
    assert.equal(response.status, 200);
    const bytes = Buffer.from(await response.arrayBuffer());
    assert.equal(createHash('sha256').update(bytes).digest('hex'), response.headers.get('x-tw-file-sha256'));
    const path = join(acceptWorkspace.rootPath, `input-${index}.json`);
    await writeFile(path, bytes); packages.push(path);
  }
  const integrated = await applyThinDeliveries({ workspace: acceptWorkspace, projectId: f.project.id, requirementId: req!.id, taskId: acceptance!.id, attemptId: acceptanceLane.attempt.id, planRevision: acceptanceLane.attempt.planRevision, packages, assertAuthority: acceptHeartbeat, assertBaseline: () => verifyThinWorkspaceBaselines({ config: acceptConfig, workspace: acceptWorkspace, entries: [entry], assertAuthority: acceptHeartbeat }) });
  assert.equal(integrated.length, 2);
  assert.equal((await readFile(join(acceptWorkspace.repositories[0]!.worktreePath, 'task-0.txt'), 'utf8')).trim(), 'deterministic 0');
  assert.equal((await readFile(join(acceptWorkspace.repositories[0]!.worktreePath, 'task-1.txt'), 'utf8')).trim(), 'deterministic 1');
  await writeFile(join(acceptWorkspace.rootPath, 'result.md'), 'Both fixture results were reviewed.\n');
  const acceptPatches = await captureThinPatches(acceptWorkspace, acceptHeartbeat);
  const acceptPackage = await packageThinArtifacts(acceptWorkspace, acceptPatches, acceptHeartbeat, join(acceptWorkspace.rootPath, 'result.md'));
  const acceptOutput = await publishThinArtifact({ apiUrl, apiKey: key.rawKey, projectId: f.project.id, ...acceptFence, path: acceptPackage, assertAuthority: acceptHeartbeat });
  await post('/api/v1/thin-workers/result', { ...acceptFence, resultKey: randomUUID(), outcome: 'done', summary: 'Fixture acceptance completed', outputId: acceptOutput.outputId });
  const staleAdvance = await fetch(`${apiUrl}/api/v1/requirements/${req!.id}/workflow-advance`, { method: 'POST', headers: { authorization: `Bearer ${owner.rawKey}`, 'content-type': 'application/json' }, body: JSON.stringify({ stage: 'delivery', decision: 'complete', expectedRevision: 0, reason: 'Fixture delivery' }) });
  assert.equal(staleAdvance.status, 409);
  const current = await db.query.requirements.findFirst({ where: eq(requirements.id, req!.id) });
  assert.equal(current!.workflowStateRevision, 3);
  const advanced = await post(`/api/v1/requirements/${req!.id}/workflow-advance`, { stage: 'delivery', decision: 'complete', expectedRevision: current!.workflowStateRevision, reason: 'Fixture delivery' }, owner.rawKey);
  assert.equal(advanced.workflowState.delivery, 'complete');
});
