import assert from 'node:assert/strict';
import test from 'node:test';
import { mkdtemp, readFile } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { createRequire } from 'node:module';
import { once } from 'node:events';
import { createDb, runMigrations, requirements, tasks, agentUsageRuns } from '../packages/db/src/index';
import { resourcePostgresFixture } from '../apps/api/src/resource-postgres-fixture';
import { runThinOnce } from '../apps/cli/src/thin-worker';
const require = createRequire(new URL('../apps/api/package.json', import.meta.url));
const { serve } = require('@hono/node-server');
const { eq } = require('drizzle-orm');
const url = process.env.TW_REAL_WORKER_DATABASE_URL;
const model = process.env.TW_REAL_CODEX_MODEL;

test('one authorized real Codex worker publishes an artifact and token evidence', { skip: process.env.TW_RUN_REAL_WORKER !== '1' || !url || !model, timeout: 180000 }, async t => {
  const parsed = new URL(url!); assert.equal(parsed.hostname, '127.0.0.1'); assert.equal(parsed.pathname, '/tw_worker_acceptance');
  await runMigrations(url!); const db = createDb(url!); t.after(() => db.$client.end());
  const root = await mkdtemp(join(tmpdir(), 'tw-worker-model-'));
  const oldStorage = process.env.TW_ATTACHMENT_STORAGE_DIR, oldConfig = process.env.TW_CONFIG_DIR;
  process.env.TW_ATTACHMENT_STORAGE_DIR = join(root, 'storage'); process.env.TW_CONFIG_DIR = join(root, 'config');
  t.after(() => { for (const [key, value] of [['TW_ATTACHMENT_STORAGE_DIR', oldStorage], ['TW_CONFIG_DIR', oldConfig]]) { if (value === undefined) delete process.env[key!]; else process.env[key!] = value; } });
  const f = await resourcePostgresFixture(db, url!);
  const agent = await f.identity.createAgent(f.owner.headers, { displayName: 'Real bounded worker' });
  await f.identity.setMembership(f.owner.headers, f.project.id, agent.id, { role: 'maintainer', explicitPermissions: [] });
  const key = await f.identity.issueKey(f.owner.headers, agent.id, { name: 'One bounded execution', expiresAt: null, grants: [{ scope: 'project', projectId: f.project.id, permissions: ['resource.read', 'resource.write', 'execution.run'] }, { scope: 'global', permissions: ['resource.read'] }] });
  const server = serve({ fetch: f.app.fetch, hostname: '127.0.0.1', port: 0 }); t.after(() => { server.closeAllConnections(); server.close(); });
  if (!server.listening) await once(server, 'listening');
  const [req] = await db.insert(requirements).values({ projectId: f.project.id, title: 'Bounded real worker acceptance', status: 'approved', createdBy: f.owner.context.actor.id }).returning();
  const [task] = await db.insert(tasks).values({ projectId: f.project.id, requirementId: req!.id, title: 'Write one local evidence file', description: 'Create result.md containing exactly: Bounded worker acceptance passed. Do not read unrelated files, access the network, execute external requests, or modify anything except result.md. Finish immediately after creating the file.', createdBy: f.owner.context.actor.id }).returning();
  const result = await runThinOnce({ config: { apiUrl: `http://127.0.0.1:${server.address().port}`, apiKey: key.rawKey, nodeId: 'bounded-model-fixture' }, projectId: f.project.id, requirementId: req!.id, model: model!, effort: 'low', timeoutMs: 120000 });
  assert.equal(result.state, 'completed', result.reason ?? 'Worker did not complete');
  assert.ok(result.workspacePath);
  assert.equal((await readFile(join(result.workspacePath, 'result.md'), 'utf8')).trim(), 'Bounded worker acceptance passed.');
  assert.equal((await db.query.tasks.findFirst({ where: eq(tasks.id, task!.id) }))!.status, 'done');
  const reports = await db.select().from(agentUsageRuns);
  assert.equal(reports.length, 1); assert.equal(reports[0]!.leaseRunId, result.attemptId);
  assert.equal(reports[0]!.summary.completeness, 'complete');
  assert.ok(reports[0]!.summary.inputTokens !== null && reports[0]!.summary.outputTokens !== null);
  console.log(JSON.stringify({ scope: 'one real model executor; disposable database; no repository delivery', model, attemptId: result.attemptId, usage: reports[0]!.summary, outcome: result.state }));
});
