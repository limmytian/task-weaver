import assert from 'node:assert/strict';
import test from 'node:test';
import { createRequire } from 'node:module';
import { randomUUID } from 'node:crypto';
import { once } from 'node:events';
import { resourcePostgresFixture } from '../apps/api/src/resource-postgres-fixture';
import { createDb, runMigrations, projects, requirements, tasks, workerAttempts, projectMemberships } from '../packages/db/src/index';
import { createAuthenticationRuntime } from '../packages/core/src/services/auth-runtime';
import { createThinWorkerService } from '../packages/core/src/services/thin-worker';
const require = createRequire(import.meta.url);
const { router } = require('../apps/web/trpc/init');
const { workerRouter } = require('../apps/web/trpc/routers/worker');
const { attentionRouter } = require('../apps/web/trpc/routers/attention');
const { projectRouter } = require('../apps/web/trpc/routers/project');
const api = createRequire(new URL('../apps/api/package.json', import.meta.url));
const { eq, and } = api('drizzle-orm');
const { serve } = api('@hono/node-server');
const { fetchRequestHandler } = api('@trpc/server/adapters/fetch');
const { build } = createRequire(require.resolve('tsx'))('esbuild');
const databaseUrl = process.env.TW_ATTENTION_E2E_DATABASE_URL;
const playwrightPath = process.env.TW_PLAYWRIGHT_MODULE;

test('browser inspects and resolves an expired worker with live authorization', { skip: !databaseUrl || !playwrightPath, timeout: 120000 }, async t => {
  const url = new URL(databaseUrl!);
  assert.equal(url.hostname, '127.0.0.1'); assert.equal(url.pathname, '/tw_attention_e2e');
  await runMigrations(databaseUrl!);
  const db = createDb(databaseUrl!); t.after(() => db.$client.end());
  let handler = async (_req: Request) => new Response('Starting', { status: 503 });
  const server = serve({ hostname: '127.0.0.1', port: 0, fetch: (req: Request) => handler(req) });
  t.after(() => { server.closeAllConnections(); server.close(); });
  await once(server, 'listening');
  const origin = `http://127.0.0.1:${server.address().port}`;
  const f = await resourcePostgresFixture(db, databaseUrl!, { webOrigin: origin, apiOrigin: origin });
  await db.update(projects).set({ workerMode: 'thin' }).where(eq(projects.id, f.project.id));
  const [req] = await db.insert(requirements).values({ projectId: f.project.id, title: 'Browser recovery', createdBy: f.owner.context.actor.id }).returning();
  const [task] = await db.insert(tasks).values({ projectId: f.project.id, requirementId: req!.id, title: 'Inspect interrupted task', status: 'in_progress', createdBy: f.owner.context.actor.id }).returning();
  const seed = async () => (await db.insert(workerAttempts).values({ projectId: f.project.id, requirementId: req!.id, taskId: task!.id, actorId: f.owner.context.actor.id, credentialId: randomUUID(), workerId: randomUUID(), nodeId: 'browser-fixture', tokenHash: 'fixture', planRevision: 1, status: 'attention', expiresAt: new Date(0) }).returning())[0]!;
  const attempt = await seed();
  const auth = createAuthenticationRuntime(db, f.configuration);
  const appRouter = router({ worker: workerRouter, attention: attentionRouter, project: projectRouter });
  const bundle = await build({ entryPoints: ['apps/web/lib/worker-browser-fixture.tsx'], bundle: true, write: false, format: 'iife', platform: 'browser', jsx: 'automatic', tsconfig: 'apps/web/tsconfig.json', define: { fixture: JSON.stringify({ projectId: f.project.id, csrf: f.owner.headers.get('x-csrf-token') }), 'process.env.NODE_ENV': '"test"', 'process.env': '{}'  } });
  handler = async request => new URL(request.url).pathname.startsWith('/api/trpc')
    ? fetchRequestHandler({ endpoint: '/api/trpc', req: request, router: appRouter, createContext: () => ({ db, auth, req: request, responseHeaders: new Headers() }) })
    : new Response(`<div id="root"></div><script>${bundle.outputFiles[0].text}</script>`, { headers: { 'content-type': 'text/html' } });
  const { chromium } = require(playwrightPath!);
  const browser = await chromium.launch({ headless: true, executablePath: process.env.TW_BROWSER_EXECUTABLE }); t.after(() => browser.close());
  const context = await browser.newContext();
  await context.addCookies(f.owner.headers.get('cookie')!.split('; ').map(pair => { const index = pair.indexOf('='); return { name: pair.slice(0, index), value: pair.slice(index + 1), url: origin }; }));
  const page = await context.newPage();
  page.on('pageerror', (error: Error) => console.error(error.message));
  page.on('console', (message: { type(): string; text(): string }) => { if (message.type() === 'error') console.error(message.text()); });
  page.setDefaultTimeout(10000);
  await page.goto(origin);
  await page.getByRole('heading', { name: 'Browser recovery', exact: true }).waitFor();
  assert.ok((await page.getByRole('link', { name: 'Inspect evidence and recovery controls', exact: true }).getAttribute('href'))!.includes(req!.id));
  await page.getByText('Resolve attempt', { exact: true }).click();
  assert.equal(await page.getByRole('button', { name: 'Retry task' }).isDisabled(), true);
  await page.getByLabel('Inspection reason').fill('Inspected workspace; no external effects remain');
  assert.equal(await page.getByRole('button', { name: 'Retry task' }).isDisabled(), true);
  await page.getByRole('checkbox').check();
  await page.getByRole('button', { name: 'Retry task' }).click();
  await page.getByText('resolved', { exact: true }).waitFor();
  await page.getByRole('heading', { name: 'Browser recovery', exact: true }).waitFor({ state: 'detached' });
  assert.equal((await db.query.tasks.findFirst({ where: eq(tasks.id, task!.id) }))!.status, 'todo');
  assert.equal((await db.query.workerAttempts.findFirst({ where: eq(workerAttempts.id, attempt.id) }))!.status, 'resolved');
  await db.update(tasks).set({ status: 'in_progress' }).where(eq(tasks.id, task!.id));
  const superseded = await seed();
  await page.reload();
  await page.getByText('Resolve attempt', { exact: true }).click();
  await page.getByLabel('Inspection reason').fill('This stale page must not resolve a replacement');
  await createThinWorkerService(f.owner.context).resolve(db, { attemptId: superseded.id, disposition: 'retry', retrySafe: true, reason: 'Inspected and resolved from another session' });
  await db.update(tasks).set({ status: 'in_progress' }).where(eq(tasks.id, task!.id));
  const replacement = await seed();
  await page.getByRole('button', { name: 'Send to review' }).click();
  await page.getByRole('alert').waitFor();
  assert.equal((await db.query.workerAttempts.findFirst({ where: eq(workerAttempts.id, replacement.id) }))!.status, 'attention');
  await page.reload();
  await page.getByText('Resolve attempt', { exact: true }).click();
  await page.getByLabel('Inspection reason').fill('Inspected replacement before authority changed');
  await db.update(projectMemberships).set({ role: 'viewer' }).where(and(eq(projectMemberships.projectId, f.project.id), eq(projectMemberships.actorId, f.owner.context.actor.id)));
  await page.getByRole('button', { name: 'Send to review' }).click();
  await page.getByRole('alert').waitFor();
  assert.equal((await db.query.workerAttempts.findFirst({ where: eq(workerAttempts.id, replacement.id) }))!.status, 'attention');
  await page.reload();
  await page.getByText('Inspect interrupted task', { exact: true }).first().waitFor();
  assert.equal(await page.getByText('Resolve attempt', { exact: true }).count(), 0);
});
