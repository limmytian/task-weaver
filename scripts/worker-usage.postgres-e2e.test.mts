import assert from 'node:assert/strict';
import test from 'node:test';
import { randomUUID } from 'node:crypto';
import { createRequire } from 'node:module';
import { resourcePostgresFixture } from '../apps/api/src/resource-postgres-fixture';
import { createDb, runMigrations, requirements, tasks, workerAttempts, agentUsageRuns } from '../packages/db/src/index';
import { createThinWorkerService } from '../packages/core/src/services/thin-worker';
const require = createRequire(new URL('../apps/api/package.json', import.meta.url));
const { eq } = require('drizzle-orm');
const url = process.env.TW_ATTENTION_E2E_DATABASE_URL;

test('worker usage is fenced, idempotent and bound to process and attempt', { skip: !url, timeout: 120000 }, async t => {
  const parsed = new URL(url!); assert.equal(parsed.hostname, '127.0.0.1'); assert.equal(parsed.pathname, '/tw_attention_e2e');
  await runMigrations(url!); const db = createDb(url!); t.after(() => db.$client.end());
  const f = await resourcePostgresFixture(db, url!);
  const agent = await f.identity.createAgent(f.owner.headers, { displayName: 'Usage executor' });
  await f.identity.setMembership(f.owner.headers, f.project.id, agent.id, { role: 'maintainer', explicitPermissions: [] });
  const key = await f.identity.issueKey(f.owner.headers, agent.id, { name: 'Usage fixture', expiresAt: null, grants: [{ scope: 'project', projectId: f.project.id, permissions: ['resource.read', 'resource.write', 'execution.run'] }, { scope: 'global', permissions: ['resource.read'] }] });
  const context = await f.auth.resolve(new Headers({ authorization: `Bearer ${key.rawKey}` }));
  const service = createThinWorkerService(context);
  const [req] = await db.insert(requirements).values({ projectId: f.project.id, title: 'Usage', status: 'approved', createdBy: f.owner.context.actor.id }).returning();
  await db.insert(tasks).values({ projectId: f.project.id, requirementId: req!.id, title: 'Metered task', createdBy: f.owner.context.actor.id });
  const workerId = randomUUID();
  const lane = await service.acquire(db, { projectId: f.project.id, requirementId: req!.id, workerId, nodeId: 'usage-fixture', executor: 'codex', model: 'fixture' });
  assert.ok(lane.attempt && lane.token);
  const body = { attemptId: lane.attempt.id, workerId, token: lane.token, processId: randomUUID(), startedAt: new Date().toISOString(), endedAt: null, revision: 0, outcome: 'running' as const, summary: { completeness: 'unknown' as const } };
  await service.reportUsage(db, body); await service.reportUsage(db, body);
  const final = { ...body, revision: 1, outcome: 'succeeded' as const, endedAt: new Date().toISOString(), summary: { completeness: 'complete' as const, inputTokens: 100, outputTokens: 20, cacheReadTokens: 80, cacheSemantics: 'included' as const } };
  await service.reportUsage(db, final); await service.reportUsage(db, final);
  const rows = await db.select().from(agentUsageRuns);
  assert.equal(rows.length, 1); assert.equal(rows[0]!.leaseRunId, lane.attempt.id); assert.equal(rows[0]!.taskId, lane.task!.id);
  assert.equal(rows[0]!.summary.inputTokens, 100); assert.equal(rows[0]!.summary.outputTokens, 20);
  await assert.rejects(service.reportUsage(db, { ...final, revision: 2, summary: { ...final.summary, inputTokens: 99 } }));
  await assert.rejects(service.reportUsage(db, { ...final, workerId: randomUUID() }));
  await db.update(workerAttempts).set({ expiresAt: new Date(0) }).where(eq(workerAttempts.id, lane.attempt.id));
  await assert.rejects(service.reportUsage(db, { ...final, revision: 2 }));
  await createThinWorkerService(f.owner.context).resolve(db, { attemptId: lane.attempt.id, disposition: 'retry', retrySafe: true, reason: 'Fixture executor stopped and effects inspected' });
  const replacement = await service.acquire(db, { projectId: f.project.id, requirementId: req!.id, workerId, nodeId: 'usage-fixture', executor: 'codex', model: 'fixture' });
  assert.ok(replacement.attempt && replacement.token);
  await assert.rejects(service.reportUsage(db, { ...final, attemptId: replacement.attempt.id, token: replacement.token }));
  const fresh = { ...body, attemptId: replacement.attempt.id, token: replacement.token, processId: randomUUID() };
  await service.reportUsage(db, fresh);
  await f.identity.setMembership(f.owner.headers, f.project.id, agent.id, { role: 'viewer', explicitPermissions: [] });
  await assert.rejects(service.reportUsage(db, { ...fresh, revision: 1 }));
  assert.equal((await db.select().from(agentUsageRuns)).length, 2);
});
