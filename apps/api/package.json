{
  "name": "@task-weaver/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/application.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@task-weaver/contracts": "workspace:^",
    "@task-weaver/core": "workspace:*",
    "@task-weaver/db": "workspace:*",
    "@task-weaver/partners-gateway": "workspace:^",
    "@task-weaver/realtime": "workspace:*",
    "@trpc/server": "^11.0.0",
    "drizzle-orm": "^0.45.3",
    "graphql": "^16.13.1",
    "graphql-yoga": "^5.18.1",
    "hono": "^4.13.9",
    "tsx": "^4.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "license": "Apache-2.0"
}
